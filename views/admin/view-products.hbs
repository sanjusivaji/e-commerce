


<section>
  <div class="container">
    <div class="row mt-4">
      <a href="admin/add-products" class="btn btn-success ml-auto">Add Product</a>
    </div>

    <table class="table table-striped mt-5">
      <thead>
        <tr>
          <th scope="col">No</th>
          <th scope="col">Title</th>
          <th scope="col">Category</th>
          <th scope="col">Description</th>
          <th scope="col">Price (₹)</th>
          <th scope="col" style="text-align: center;">Discount(%)(Optional)</th>
          <th scope="col">Tax (%)</th>
          <th scope="col">Stock</th>
          <th scope="col">Images</th>
          <th scope="col">Video</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each products}}
        <tr>
          <th scope="row">{{inc @index}}</th>
          <td>{{this.name}}</td>
          <td>{{this.category}}</td>
          <td>{{this.description}}</td>
          <td>{{this.price}}</td>
          {{#if this.discount}}
              <td style="text-align: center;">{{this.discount}}</td>
          {{else  }}
              <td> </td>
          {{/if}}

          <td style="text-align: center;">{{this.taxRate}}</td>
          <td>
            {{#if this.inStock}}
                <span class="text-success">In Stock</span>
            {{else}}
                <span class="text-danger">Out of Stock</span>
            {{/if}}
          </td>
          <td>
            {{#each this.images}}
              <img src="/{{this}}" style="width: 50px; height: 50px; margin: 2px; object-fit: conver" />
            {{/each}}
          </td>
          <td>
            {{#if this.video}}
              <video width="100" controls>
                <source src="/{{this.video}}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            {{else}}
              No Video
            {{/if}}
          </td>
          <td>
            <a href="/admin/edit-product/{{this._id}}" class="btn btn-primary btn-sm">Edit</a>
            <a href="/admin/delete-product/{{this._id}}" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete {{this.name}}?')">Delete</a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>