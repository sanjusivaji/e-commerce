<h3 class="text-center mt-4" style="color: rgb(246, 44, 202);">All Users & Their Orders</h3>

<div class="container">
  {{#each usersWithOrders}}
    <div class="card mb-4 p-3">
      <!-- User info (displayed once) -->
      <h5 style="color: rgb(246, 44, 202);">{{this.name}}</h5>
      <p><strong>Email:</strong> {{this.email}}</p>

      {{!-- Show first order's address details (assuming all orders use same address) --}}
      {{#if this.orders.[0]}}
        <p><strong>Phone:</strong> {{this.orders.[0].address.phoneNumber}}</p>
        <p>
          <strong>Address:</strong> 
          {{this.orders.[0].address.fullName}}, 
          {{this.orders.[0].address.street}}, 
          {{this.orders.[0].address.city}}, 
          {{this.orders.[0].address.state}}, 
          {{this.orders.[0].address.pincode}}
        </p>
      {{/if}}

      <hr>

      <!-- Orders list -->
      <h6 class="mt-3">Orders:</h6>
      {{#each this.orders}}
        <div class="border p-2 mb-2">
          <p><strong>Order ID:</strong> {{_id}}</p>
          <p><strong>Total Amount:</strong> ₹{{totalAmount}}</p>
          <p><strong>Payment:</strong> {{paymentMethod}}</p>
          <p><strong>Order Status:</strong> {{status}}</p>
          <p><strong>Date:</strong> {{formatDate date}}</p>
        </div>
      {{/each}}

    </div>
  {{/each}}
</div>
