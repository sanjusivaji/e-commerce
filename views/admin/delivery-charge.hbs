   <div class="container my-4">
  <div class="row">

    <!-- In left side, Invoice Settings Form -->
    <div class="col-md-6"> 
      <div class="border p-3 rounded bg-light">
        <form action="/admin/delivery-charge" method="POST">
          <input type="hidden" name="orderId" value="{{order._id}}">

          <h4>Shipping</h4>
          <div class="mb-2">
            <label>Shipping Cost ₹:
              <input name="shippingCost" type="number" class="form-control" required>
            </label>
          </div>
          <div class="mb-2">
            <label>Promotion Discount ₹ (optional):
              <input name="promotionDiscount" type="number" step="1" class="form-control">
            </label>
          </div>

          <h4>Seller Details</h4>
          <div class="mb-2"><label>Company Name: <input name="companyName" class="form-control" required></label></div>
          <div class="mb-2"><label>Road: <input name="road" class="form-control" required></label></div>
          <div class="mb-2"><label>Place: <input name="place" class="form-control" required></label></div>
          <div class="mb-2"><label>City: <input name="city" class="form-control" required></label></div>
          <div class="mb-2"><label>Pincode: <input name="pincode" class="form-control" required></label></div>
          <div class="mb-2"><label>State: <input name="state" class="form-control" required></label></div>
          <div class="mb-2"><label>Nation: <input name="nation" class="form-control" required></label></div>
          <div class="mb-2"><label>Phone Number: <input name="phone" class="form-control" required></label></div>
          <div class="mb-2"><label>Email: <input name="email" type="email" class="form-control" required></label></div>
          <div class="mb-2"><label>GSTIN: <input name="gstin" class="form-control" required></label></div>

          <button type="submit" class="btn btn-dark btn-sm">Set Invoice / BILL</button>
        </form>
      </div>
    </div>

    <!-- In right side, Saved Invoice Settings -->
    <div class="col-md-6">
      <div class="border p-3 rounded bg-white">
        <h4>Seller Address & Shipping cost</h4>

        {{#each invoiceSettings}}
          <div class="border p-3 mb-3 rounded bg-light">
            <p><strong>Shipping:</strong> ₹{{shippingCost}}</p>
            <p><strong>Discount:</strong> ₹{{promotionDiscount}}</p>
            <p><strong>Company:</strong> {{companyName}}</p>
            <p><strong>Address:</strong> {{road}}, {{place}}, {{city}} - {{pincode}}, {{state}}, {{nation}}</p>
            <p><strong>Phone:</strong> {{phone}} | <strong>Email:</strong> {{email}}</p>
            <p><strong>GSTIN:</strong> {{gstin}}</p>

          
          </div>
        {{else}}
          <p>No invoice settings saved yet.</p>
        {{/each}}
      </div>
    </div>

  </div>
</div>
   
   
  