


<div class="pickup-box mt-4" style="max-width: 500px; margin: auto;">
  <h4>Set Pickup Date & Message</h4>

  {{!-- Form, for sending message and pickup date to user --}}
  <form id="pickup-form" action="/admin/set-pickup-message" method="POST" >
    <input type="hidden" name="orderId" value="{{orderId}}">
    <input type="hidden" id="refundDate" value="{{refundDate}}">    {{!-- 'refund date'--}}

    <div class="mb-3">
      <label for="pickupDate">Pickup Date:</label>
      <input type="date" id="pickupDate" name="pickupDate"  class="form-control w-auto" required>   {{!-- 'pickup date' --}}
    </div>

    <div class="mb-3">
      <label for="message">Message to User:</label>
      <textarea name="message" class="form-control" placeholder="Type your message...   Eg)'Pickup person's mobile number is... " required>{{adminMessage}}</textarea>
    </div>

    <button type="submit" class="btn btn-warning">Set Message & Date</button>
  </form>
  
  {{!-- Display admin message and pickup date already created and sent above--}}
  <div class="pickup-display mt-3" id="pickup-display" style="display: {{#if pickupDate}}block{{else}}none{{/if}}">    {{!--  Only display the box if 'pickupdate' appears --}}
    <strong>Pickup Date:</strong> <span id="display-pickup">{{ pickupDate}}</span><br>
    <strong>Message:</strong> <span id="display-message">{{adminMessage}}</span>
  </div>

  {{!-- For complete the refund --}}
    <div class="mt-3">
      <form id="refund-complete-form" action="/admin/complete-refund" method="POST" onsubmit="return handleRefundCompletion(event)">
        <input type="hidden" name="orderId" value="{{orderId}}">
        <button type="submit" class="btn btn-success">Refund Completed</button>
      </form>
    </div>
</div>



<style>
  .pickup-box {
    max-width: 500px;
    margin: auto;
    padding: 20px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background-color: #f9f9f9;
  }
  .pickup-display {
    margin-top: 20px;
    background-color: #eef9f0;
    padding: 10px 15px;
    border-left: 4px solid #4caf50;
    border-radius: 5px;
    display: none;
  }
</style>

<script>
  const formatDate = (date) => date.toISOString().split('T')[0];

  document.addEventListener("DOMContentLoaded", () => {
    const refundDateStr = document.getElementById('refundDate').value;  // Retrieve value of 'refundDate' from '<input>' by using 'value' attribute and it's a 'string'(because any value inside 'value="...", always put in " ").
    if (!refundDateStr) return;

    const refundDate = new Date(refundDateStr);                        // Convert string into 'js' 'date object'.           
    const pickupInput = document.getElementById('pickupDate');         // Retrieve 'pickup date',for reassign.

    const minDate = new Date(refundDate);                              // Set 'minDate',the new 'date object', and its value is '+1' day after 'refundDate'.
    minDate.setDate(minDate.getDate() + 1);

    const maxDate = new Date(refundDate);
    maxDate.setDate(maxDate.getDate() + 5);

    pickupInput.min = formatDate(minDate);                             // 'pickupInput' is  the value of 'calender' and 'min' and 'max' are 'built-in' html attributes mostly used in 'date','number' etc type, and it allows the 'range' in the calender.
    pickupInput.max = formatDate(maxDate);
  });


  // For 'Refund complete'
  async function handleRefundCompletion(event) {
    event.preventDefault();
    if (!confirm("Are you sure you have completed the refund process?")) return;  // 'confirm' is the 'js' browser method for popup message and returns 'ture' or 'false' and in '!confirm()',user click 'cancel' button of popup,go to 'return' and then function stops.

    const form = document.getElementById('refund-complete-form'); // Retrieved data of '<form>'
    const formData = new FormData(form);  // Creates a built-in js object 'formData' and it holds all data of '<form>' like 'name','value','files' etc. 

    const res = await fetch(form.action, {  // We can directly use 'route'(ie '/admin/complete-refund') instead 'form.action'
      method: 'POST',
      body: formData
    });

    const data = await res.json();

    if (data.success) {
      document.getElementById('pickup-display').style.display = 'none';
      alert("Refund marked as completed.");   // After 'Refund completed' display a 'popup message'
    } else {
      alert("Failed to complete refund: " + data.error);
    }
  }
</script>



