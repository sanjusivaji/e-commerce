<div class="container mt-5">
  <div class="payment-box p-4">

    <!-- Address Section -->
    <div class="alert alert-info mb-4">
      <p>Delivering to: <strong>{{userAddress.fullName}}</strong></p> 
      <p>{{userAddress.houseNo}}, {{userAddress.street}}, {{userAddress.city}}, {{userAddress.state}}, {{userAddress.pincode}}</p>
    </div>

    <!-- Payment Selection -->
    <h4>Select Payment Method</h4>
    <form id="paymentForm">
     <div class="form-check custom-radio d-flex justify-content-between align-items-center mb-2">
  <label class="form-check-label me-3" for="razorpay">UPI, Net Banking</label>
  <input class="form-check-input" type="radio" name="paymentMethod" value="razorpay" id="razorpay">
</div>

<div class="form-check custom-radio d-flex justify-content-between align-items-center mb-2">
  <label class="form-check-label me-3" for="paypal">PayPal</label>
  <input class="form-check-input" type="radio" name="paymentMethod" value="paypal" id="paypal">
</div>

<div class="form-check custom-radio d-flex justify-content-between align-items-center mb-2">
  <label class="form-check-label me-3" for="cod">Cash on Delivery</label>
  <input class="form-check-input" type="radio" name="paymentMethod" value="cod" id="cod">
</div>

      <button type="button" id="proceedPayment" class="btn btn-primary mt-3">Continue</button>
    </form>

  </div>
</div>

<style>
  @media (max-width: 800px) {
    .form-check {
      padding: 10px 0;
      margin-right: 100px;
      margin-left: 0px;
    }

    .form-check-label {
      font-size: 15px;
      margin-right: 100px;
    }

    .form-check-input {
      transform: scale(1.2);
    }
  }
</style>

<script>
document.getElementById("proceedPayment").addEventListener("click", function() {
    let paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value; // Select 'input' element with 'name=paymentMethod' and its 'value'
    
    if (!paymentMethod) {
        alert("Please select a payment method.");
        return;
    }

    if (paymentMethod === "razorpay") {   // If 'paymentMethod === ...' is 'true', 'window.location.href'(for 'js') 'trigger' the route. 
        window.location.href = "/razorpay/pay";
    } else if (paymentMethod === "paypal") {
        window.location.href = "/paypal/pay";
    } else{
        window.location.href = "/cash-on-delivery";
    }
            
});
</script>