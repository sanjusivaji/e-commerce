

    <div style="display: flex; gap: 20px;">
        <!-- For entering address -->
        <form id="addressForm">
            <input type="text" id="fullName" name="fullName" placeholder="Enter your full name" required>
            <input type="text" id="phoneNumber" name="phoneNumber" placeholder="Enter your phone number" required>
            <input type="text" id="houseNo" name="houseNo" placeholder="House no" required>
            <input type="text" id="street" name="street" placeholder="Your street" required>
            <input type="text" id="landmark" name="landmark" placeholder="Landmark">
            <input type="text" id="pincode" name="pincode" placeholder="Pincode" required>
            <input type="text" id="city" name="city" placeholder="Town/City" required>
            <input type="text" id="state" name="state" placeholder="State" required>
            <textarea id="instructions" name="instructions" rows="3" placeholder="Delivery instructions (optional)"></textarea>
            <div>
                <label>
                    <input type="checkbox" id="defaultAddress" name="defaultAddress"> Make it default address
                </label>
            </div>
            <button type="submit" class="save-button">Save Address</button>
        </form>

        {{!-- For display warning message --}}
        <div id="message-box" class="message-box" style="display: none;"></div>

        {{!-- For display Address List --}}
        <div id="addressList">
            {{#each addresses}}
            <div class="address-box" data-id="{{this._id}}">
                <p><strong>{{this.fullName}}</strong></p>
                <p>{{this.phoneNumber}}, {{this.houseNo}}, {{this.street}}, {{this.city}}, {{this.state}}, {{this.pincode}}</p>
                <p><small>{{this.instructions}}</small></p>
                 {{#if this.default}}
                 <p style="color:green">  Default Address  </p>
                {{/if}}
                <button class="edit-btn">Edit</button>
                <button class="delete-btn">Delete</button>
                <button class="default-btn">Make Default</button>
            </div>
            {{/each}}
        </div>

    </div>

   
    <script>
    document.addEventListener('DOMContentLoaded', function () {
    const addressForm = document.getElementById('addressForm');
    const addressList = document.getElementById('addressList');
    const messageBox = document.getElementById("message-box");

    // Handle 'form' submission for adding address 
    addressForm.addEventListener('submit', function (event) {
        event.preventDefault();

        const formData = new FormData(this); // 'FormData' object collect all data(except 'checkbox')in the '<form>' as 'name:value'(eg, 'fullName:Alice') pairs.
        const jsonData = Object.fromEntries(formData.entries());  // 'formData.entries()' create an 'iterator' for iterate the 'key:value' pairs and 'Object.fromEntries' convert into 'js' object.
        jsonData.defaultAddress = document.getElementById('defaultAddress').checked; // Retrieve 'checkbox' data ie if 'checked', 'defaultAddress:true'.

        const editId = this.getAttribute('data-edit-id');  // 'data-edit-id' created dynamically in 'editAddress()'.
        const url = editId ? `/update-address/${editId}` : '/add-address';  // If 'editId' created, go to 'url' for editing or go to 'adding' address.
        const method = editId ? 'PUT' : 'POST';

        fetch(url, {   // For both 'edit' and 'add' address
            method: method,
            headers: { 'Content-Type': 'application/json' }, // Tells to server,sending 'json' data in 'req.body' 
            body: JSON.stringify(jsonData) // Converts 'jsonData' object into 'json string'.
        })
        .then(response => response.json())
        .then(data => {
            if (data.status) {
                messageBox.style.display = "none"; // Hide 'error' message.
                location.reload();                 // For refresh the page
            } else {
                messageBox.textContent = data.message;  // 'textContent' sets plain text and display 'error' message.
                messageBox.style.display = "block";
            }
        })
        .catch(console.error);

        this.removeAttribute('data-edit-id'); // Reset form after submission
    });

    // Handle Edit, Delete and Make Default buttons
    addressList.addEventListener('click', function (event) {
        const target = event.target;
        const addressBox = target.closest('.address-box');  // Finding the 'target'(ie 'button') and closest ancestor element(ie 'address')
        if (!addressBox) return;
        
        const addressId = addressBox.dataset.id;
        if (target.classList.contains('edit-btn')) editAddress(addressId);  // If class 'edit-btn'(ie 'Edit' button)triggered, invoke 'editAddress()' for further operations.
        if (target.classList.contains('delete-btn')) handleAddressAction('/delete-address/', addressId, 'DELETE');
        if (target.classList.contains('default-btn')) handleAddressAction('/make-default-address/', addressId, 'PUT');
    });

    function editAddress(id) {
        fetch('/get-address/' + id)
            .then(response => response.json())
            .then(data => {                                        // Handle the 'response object' contains 'document'.
                Object.entries(data).forEach(([key, value]) => {   // 'Object.entries()' convert 'data' document into 'array of key-value' pairs
                    const field = document.getElementById(key);    // Retrieve data of 'editing field' by 'key' and already inputed 'id'
                    if (field) field.type === 'checkbox' ? field.checked = value : field.value = value; 
                });
                addressForm.setAttribute('data-edit-id', id);      // Dynamically set attribute with 'id' for 'edit mode'.
            })
            .catch(console.error);
    }

    function handleAddressAction(url, id, method) {
        fetch(url + id, { method })
            .then(response => response.json())
            .then(() => location.reload())
            .catch(console.error);
    }
});
</script>



