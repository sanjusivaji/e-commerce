  th, td {
    border: 1px solid #ddd;
    text-align: left;
    padding: 8px;
    font-size: 14px;
  }

  th {
    background-color: #f8f8f8;
    text-transform: uppercase;
  }

  .btn {
    padding: 6px 12px;
